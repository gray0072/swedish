{
  "items": [
    {
      "id": "foer-att-purpose",
      "sv": "för att",
      "translations": { "ru": "для того чтобы, чтобы (цель)", "en": "in order to/that (purpose)" },
      "pos": "conjunction",
      "example": { "sv": "Hon sprang för att hon skulle hinna med tåget.", "ru": "Она бежала, чтобы успеть на поезд.", "en": "She ran so that she would catch the train." },
      "note": { "ru": "Перед личным глаголом — полное придаточное; перед инфинитивом (без своего подлежащего) — инфинитивный оборот.", "en": "Before a finite verb it's a full clause; before an infinitive (with no subject of its own) it's an infinitive phrase." }
    },
    {
      "id": "utan-att",
      "sv": "utan att",
      "translations": { "ru": "не (делая чего-л.), без того чтобы", "en": "without (doing something)" },
      "pos": "conjunction",
      "example": { "sv": "Han gick utan att säga hejdå.", "ru": "Он ушёл, не попрощавшись.", "en": "He left without saying goodbye." }
    },
    {
      "id": "istaellet-foer-att",
      "sv": "istället för att",
      "translations": { "ru": "вместо того чтобы", "en": "instead of" },
      "pos": "conjunction",
      "example": { "sv": "Hon läste en bok istället för att titta på tv.", "ru": "Она читала книгу, вместо того чтобы смотреть телевизор.", "en": "She read a book instead of watching TV." }
    },
