    {
      "id": "hoppas",
      "sv": "hoppas",
      "translations": { "ru": "надеяться", "en": "to hope" },
      "pos": "verb",
      "verbGroup": 1,
      "forms": { "infinitive": "hoppas", "present": "hoppas", "past": "hoppades", "supine": "hoppats" },
      "note": { "ru": "Депонентный глагол — всегда с -s, нет формы без «s».", "en": "A deponent verb — it always has -s; there is no non-\"s\" form." },
