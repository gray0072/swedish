      "example": { "sv": "Vännerna kramas när de möts.", "ru": "Друзья обнимаются, когда встречаются.", "en": "The friends hug each other when they meet." }
    },
    {
      "id": "skiljas",
      "sv": "skiljas",
      "translations": { "ru": "расставаться, разводиться", "en": "to part ways, to get divorced" },
