{
  "items": [
    {
      "id": "traffas",
      "sv": "träffas",
      "translations": { "ru": "встречаться (друг с другом)", "en": "to meet (each other)" },
      "pos": "verb",
      "verbGroup": 1,
      "forms": { "infinitive": "träffas", "present": "träffas", "past": "träffades", "supine": "träffats" },
      "note": { "ru": "От «träffa» (встретить кого-то) + s = «встречаться друг с другом».", "en": "From \"träffa\" (to meet someone) + -s = \"to meet each other\"." },
      "example": { "sv": "Vi träffas klockan sju.", "ru": "Мы встречаемся друг с другом в семь.", "en": "We're meeting (each other) at seven." }
    },
    {
      "id": "ses",
      "sv": "ses",
      "translations": { "ru": "видеться (друг с другом)", "en": "to see each other" },
      "pos": "verb",
      "verbGroup": 4,
      "forms": { "infinitive": "ses", "present": "ses", "past": "sågs", "supine": "setts" },
      "note": { "ru": "От «se» (видеть) + s = «видеться».", "en": "From \"se\" (to see) + -s = \"to see each other\"." },
      "example": { "sv": "Vi ses imorgon!", "ru": "Увидимся завтра!", "en": "See you tomorrow!" }
    },
    {
      "id": "kramas",
      "sv": "kramas",
      "translations": { "ru": "обниматься", "en": "to hug (each other)" },
      "pos": "verb",
      "verbGroup": 1,
      "forms": { "infinitive": "kramas", "present": "kramas", "past": "kramades", "supine": "kramats" },
