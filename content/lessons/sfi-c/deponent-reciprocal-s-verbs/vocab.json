      "verbGroup": 4,
      "forms": { "infinitive": "skiljas", "present": "skiljs", "past": "skildes", "supine": "skilts" },
      "note": { "ru": "От «skilja» (разделить) + s = «расставаться друг с другом».", "en": "From \"skilja\" (to separate something) + -s = \"to part ways with each other\"." },
