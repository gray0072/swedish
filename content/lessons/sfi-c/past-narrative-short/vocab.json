{
  "items": [
    {
      "id": "jag-akte",
      "sv": "jag åkte",
      "translations": { "ru": "я поехал(а)", "en": "I went (travelled)" },
      "pos": "phrase",
      "note": { "ru": "претерит глагола «åka» — ехать", "en": "preterite of \"åka\" — to travel" },
      "example": { "sv": "Igår åkte jag till stan.", "ru": "Вчера я поехал(а) в город.", "en": "Yesterday I went to town." }
    },
    {
      "id": "jag-traffade",
      "sv": "jag träffade",
      "translations": { "ru": "я встретил(а)", "en": "I met" },
