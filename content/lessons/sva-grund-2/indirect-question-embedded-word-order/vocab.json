      "translations": { "ru": "косвенный вопрос", "en": "indirect question" },
      "pos": "phrase",
      "note": { "ru": "Вопрос, встроенный внутрь другого предложения, без вопросительного порядка слов.", "en": "A question embedded inside another sentence, without question word order." }
