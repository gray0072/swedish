      "forms": { "infinitive": "upprepa", "present": "upprepar", "past": "upprepade", "supine": "upprepat", "imperative": "upprepa" },
      "example": { "sv": "Upprepa efter mig.", "ru": "Повторяйте за мной.", "en": "Repeat after me." }
