      "forms": { "infinitive": "läsa", "present": "läser", "past": "läste", "supine": "läst", "imperative": "läs" },
      "example": { "sv": "Läs texten på sidan tio.", "ru": "Читайте текст на странице десять.", "en": "Read the text on page ten." }
    },
    {
