{
  "items": [
    {
      "id": "oppet",
      "sv": "ÖPPET",
      "translations": { "ru": "открыто", "en": "open" },
      "pos": "adj",
      "forms": { "positive": "öppen", "neuter": "öppet", "plural": "öppna", "comparative": "öppnare", "superlative": "öppnast" },
      "note": { "ru": "Обычная запись: öppet.", "en": "Written normally: öppet." },
      "example": { "sv": "Det är öppet idag.", "ru": "Сегодня открыто.", "en": "It is open today." }
    },
    {
      "id": "stangt",
      "sv": "STÄNGT",
      "translations": { "ru": "закрыто", "en": "closed" },
      "pos": "adj",
      "forms": { "positive": "stängd", "neuter": "stängt", "plural": "stängda", "comparative": "mer stängd", "superlative": "mest stängd" },
      "note": { "ru": "Обычная запись: stängt.", "en": "Written normally: stängt." },
      "example": { "sv": "Det är stängt på söndagar.", "ru": "По воскресеньям закрыто.", "en": "It is closed on Sundays." }
    },
    {
      "id": "ingang",
      "sv": "INGÅNG",
      "translations": { "ru": "вход", "en": "entrance" },
      "pos": "noun",
      "gender": "en",
      "forms": { "indefSg": "en ingång", "defSg": "ingången", "indefPl": "ingångar", "defPl": "ingångarna" },
      "example": { "sv": "Ingången är på baksidan.", "ru": "Вход находится с задней стороны.", "en": "The entrance is at the back." }
    },
    {
      "id": "utgang",
      "sv": "UTGÅNG",
      "translations": { "ru": "выход", "en": "exit" },
      "pos": "noun",
      "gender": "en",
      "forms": { "indefSg": "en utgång", "defSg": "utgången", "indefPl": "utgångar", "defPl": "utgångarna" },
      "example": { "sv": "Utgången är till vänster.", "ru": "Выход слева.", "en": "The exit is on the left." }
    },
    {
      "id": "nodutgang",
      "sv": "NÖDUTGÅNG",
      "translations": { "ru": "аварийный выход", "en": "emergency exit" },
      "pos": "noun",
      "gender": "en",
      "forms": { "indefSg": "en nödutgång", "defSg": "nödutgången", "indefPl": "nödutgångar", "defPl": "nödutgångarna" },
      "note": { "ru": "nöd- значит «беда, авария».", "en": "nöd- means \"emergency, distress\"." },
      "example": { "sv": "Nödutgången är bredvid trappan.", "ru": "Аварийный выход рядом с лестницей.", "en": "The emergency exit is next to the stairs." }
    },
    {
      "id": "toalett",
      "sv": "TOALETT",
      "translations": { "ru": "туалет", "en": "toilet" },
      "pos": "noun",
      "gender": "en",
      "forms": { "indefSg": "en toalett", "defSg": "toaletten", "indefPl": "toaletter", "defPl": "toaletterna" },
      "example": { "sv": "Toaletten är stängd just nu.", "ru": "Туалет сейчас закрыт.", "en": "The toilet is closed right now." }
    },
    {
      "id": "wc",
      "sv": "WC",
      "translations": { "ru": "туалет (WC)", "en": "toilet (WC)" },
      "pos": "noun",
      "gender": "ett",
      "forms": { "indefSg": "ett wc", "defSg": "wc:et", "indefPl": "wc", "defPl": "wc:na" },
      "note": { "ru": "То же, что TOALETT. Часто просто буквы WC.", "en": "The same as TOALETT. Often just the letters WC." },
      "example": { "sv": "WC finns på andra våningen.", "ru": "Туалет находится на втором этаже.", "en": "The WC is on the second floor." }
    },
    {
      "id": "damer",
      "sv": "DAMER",
      "translations": { "ru": "женский (туалет)", "en": "ladies" },
      "pos": "noun",
      "gender": "en",
      "forms": { "indefSg": "en dam", "defSg": "damen", "indefPl": "damer", "defPl": "damerna" },
      "note": { "ru": "en dam — женщина, дама; damer — женщины.", "en": "en dam — a lady; damer — ladies." },
      "example": { "sv": "Skylten DAMER visar var damtoaletten är.", "ru": "Табличка DAMER показывает, где женский туалет.", "en": "The sign DAMER shows where the ladies' room is." }
    },
    {
      "id": "herrar",
      "sv": "HERRAR",
      "translations": { "ru": "мужской (туалет)", "en": "gentlemen" },
      "pos": "noun",
      "gender": "en",
      "forms": { "indefSg": "en herre", "defSg": "herren", "indefPl": "herrar", "defPl": "herrarna" },
      "note": { "ru": "en herre — мужчина, господин; herrar — мужчины.", "en": "en herre — a gentleman; herrar — gentlemen." },
      "example": { "sv": "Skylten HERRAR visar var herrtoaletten är.", "ru": "Табличка HERRAR показывает, где мужской туалет.", "en": "The sign HERRAR shows where the men's room is." }
    },
    {
      "id": "dra",
      "sv": "DRA",
      "translations": { "ru": "тянуть (на себя)", "en": "pull" },
      "pos": "verb",
      "verbGroup": 4,
      "forms": { "infinitive": "dra", "present": "drar", "past": "drog", "supine": "dragit", "imperative": "dra" },
      "note": { "ru": "На двери: тянуть дверь к себе.", "en": "On a door: pull the door towards you." },
      "example": { "sv": "Man ska dra i dörren, inte trycka.", "ru": "Дверь нужно тянуть, а не толкать.", "en": "You should pull the door, not push it." }
    },
    {
      "id": "tryck",
      "sv": "TRYCK",
      "translations": { "ru": "толкать (от себя)", "en": "push" },
      "pos": "verb",
      "verbGroup": 2,
      "forms": { "infinitive": "trycka", "present": "trycker", "past": "tryckte", "supine": "tryckt", "imperative": "tryck" },
      "note": { "ru": "На двери: толкать дверь от себя.", "en": "On a door: push the door away from you." },
      "example": { "sv": "Tryck på knappen för att öppna dörren.", "ru": "Нажми на кнопку, чтобы открыть дверь.", "en": "Push the button to open the door." }
    },
