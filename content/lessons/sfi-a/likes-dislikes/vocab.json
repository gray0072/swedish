{
  "items": [
    {
      "id": "gilla",
      "sv": "gilla",
      "translations": { "ru": "нравиться, любить", "en": "to like" },
      "pos": "verb",
      "verbGroup": 1,
      "forms": { "infinitive": "gilla", "present": "gillar", "past": "gillade", "supine": "gillat", "imperative": "gilla" },
      "example": { "sv": "Jag gillar min lärare.", "ru": "Мне нравится мой учитель.", "en": "I like my teacher." }
    },
    {
      "id": "jag-gillar-kaffe",
      "sv": "Jag gillar kaffe.",
      "translations": { "ru": "Я люблю кофе.", "en": "I like coffee." },
      "pos": "phrase",
      "example": { "sv": "Jag gillar kaffe med mjölk.", "ru": "Я люблю кофе с молоком.", "en": "I like coffee with milk." }
    },
    {
      "id": "jag-gillar-inte-kaffe",
      "sv": "Jag gillar inte kaffe.",
      "translations": { "ru": "Я не люблю кофе.", "en": "I do not like coffee." },
      "pos": "phrase",
      "note": { "ru": "«inte» стоит после глагола, а не перед ним", "en": "\"inte\" comes after the verb, never before it" },
      "example": { "sv": "Jag gillar inte kaffe, jag dricker te.", "ru": "Я не люблю кофе, я пью чай.", "en": "I do not like coffee, I drink tea." }
    },
    {
      "id": "tycker-om",
      "sv": "Jag tycker om att läsa.",
      "translations": { "ru": "Мне нравится читать.", "en": "I like to read." },
      "pos": "phrase",
      "note": { "ru": "«tycka om» = «gilla». Отрицание: Jag tycker inte om...", "en": "\"tycka om\" = \"gilla\". Negation: Jag tycker inte om..." },
      "example": { "sv": "Jag tycker om att läsa på kvällen.", "ru": "Мне нравится читать вечером.", "en": "I like to read in the evening." }
    },
    {
      "id": "jag-alskar-choklad",
      "sv": "Jag älskar choklad.",
      "translations": { "ru": "Я обожаю шоколад.", "en": "I love chocolate." },
      "pos": "phrase",
      "note": { "ru": "«älskar» сильнее, чем «gillar»", "en": "\"älskar\" is stronger than \"gillar\"" },
      "example": { "sv": "Jag älskar choklad och glass.", "ru": "Я обожаю шоколад и мороженое.", "en": "I love chocolate and ice cream." }
    },
    {
      "id": "jag-hatar",
      "sv": "Jag hatar...",
      "translations": { "ru": "Я ненавижу...", "en": "I hate..." },
      "pos": "phrase",
      "note": { "ru": "очень сильное слово — в быту чаще говорят «Jag gillar inte...»", "en": "a very strong word — in everyday talk people say \"Jag gillar inte...\"" },
      "example": { "sv": "Jag hatar spindlar.", "ru": "Я ненавижу пауков.", "en": "I hate spiders." }
    },
    {
      "id": "gillar-du",
      "sv": "Gillar du...?",
      "translations": { "ru": "Тебе нравится...?", "en": "Do you like...?" },
      "pos": "phrase",
      "example": { "sv": "Gillar du fisk?", "ru": "Ты любишь рыбу?", "en": "Do you like fish?" }
    },
    {
      "id": "vad-gillar-du",
