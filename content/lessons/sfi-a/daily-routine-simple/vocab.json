    {
      "id": "jag-vaknar",
      "sv": "Jag vaknar klockan sju.",
      "translations": { "ru": "Я просыпаюсь в семь.", "en": "I wake up at seven." },
      "pos": "phrase",
      "example": { "sv": "Jag vaknar klockan sju varje dag.", "ru": "Я просыпаюсь в семь каждый день.", "en": "I wake up at seven every day." }
    },
