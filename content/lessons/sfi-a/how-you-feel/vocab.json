{
  "items": [
    {
      "id": "hur-mar-du",
      "sv": "Hur mår du?",
      "translations": { "ru": "Как ты себя чувствуешь?", "en": "How are you feeling?" },
      "pos": "phrase",
      "example": { "sv": "Hej Anna! Hur mår du idag?", "ru": "Привет, Анна! Как ты сегодня?", "en": "Hi Anna! How are you feeling today?" }
    },
    {
      "id": "jag-mar-bra",
      "sv": "Jag mår bra.",
      "translations": { "ru": "Я чувствую себя хорошо.", "en": "I feel fine." },
      "pos": "phrase",
      "example": { "sv": "Tack, jag mår bra.", "ru": "Спасибо, я в порядке.", "en": "Thanks, I feel fine." }
    },
    {
      "id": "jag-mar-daligt",
      "sv": "Jag mår dåligt.",
      "translations": { "ru": "Мне плохо.", "en": "I feel bad." },
      "pos": "phrase",
      "example": { "sv": "Jag mår dåligt, jag går hem.", "ru": "Мне плохо, я иду домой.", "en": "I feel bad, I am going home." }
    },
    {
      "id": "jag-mar-inte-bra",
      "sv": "Jag mår inte bra.",
      "translations": { "ru": "Мне нехорошо.", "en": "I do not feel well." },
