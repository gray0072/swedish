      "forms": { "infinitive": "anse", "present": "anser", "past": "ansåg", "supine": "ansett" },
      "example": { "sv": "Jag anser att alla borde lära sig svenska.", "ru": "Я полагаю, что всем следует учить шведский.", "en": "I'm of the opinion that everyone should learn Swedish." }
    },
    {
