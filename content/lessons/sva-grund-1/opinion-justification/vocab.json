{
  "items": [
    {
      "id": "tycka",
      "sv": "tycka",
      "translations": { "ru": "считать, иметь мнение", "en": "to think, to have an opinion" },
      "pos": "verb",
      "verbGroup": 2,
      "forms": { "infinitive": "tycka", "present": "tycker", "past": "tyckte", "supine": "tyckt" },
      "example": { "sv": "Jag tycker att svenska är roligt.", "ru": "Я считаю, что шведский — это интересно.", "en": "I think Swedish is fun." }
    },
    {
      "id": "anse",
      "sv": "anse",
      "translations": { "ru": "полагать, считать (формально)", "en": "to consider, to be of the opinion" },
